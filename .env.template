UHN_MQTT_BROKER_URL=mqtt://localhost or container hostname and port

DATABASE_HOST=localhost or container hostname
DATABASE_PORT=3306

DOMAIN_NAME=

REMOTE_HOST_H2C=http://localhost:3010
REMOTE_HOST_DEMO=http://localhost:3020
REMOTE_HOST_UHN=http://localhost:3030
REMOTE_HOST_AUD=http://localhost:3040

AUD_AMPLIFIER_HOST=host name or IP address of the Yamaha amplifier (optionally with :port)
AUD_AMPLIFIER_INPUTS="inputs to show with labels, e.g. AV5=Music App,HDMI1=Chromecast,TUNER" (optional, default all inputs of the amplifier; keep the quotes, devserver.sh sources this file)
AUD_TUNER_STATIONS_FILE=path of the tuner station list, a JSON file described in docs/aud/amplifier.md (optional, without it the tuner shows the presets stored in the amplifier)
AUD_MUSIC_ROOT=folder with the music, laid out as Artist/Album/tracks, described in docs/aud/library.md (optional, without it the music library is empty)
AUD_DATA_DIR=folder where aud keeps its data, such as the cache of the music scan (optional, without it every start scans all files)
AUD_PLAYER=mpv or fake (optional, default mpv; fake only counts the time of the tracks, for development without speakers)
AUD_MPV_COMMAND=the mpv program (optional, default mpv)
AUD_MPV_AUDIO_DEVICE=audio output of mpv, as listed by `mpv --audio-device=help`, e.g. alsa/plughw:0,0 (optional, mpv chooses)

JWT_SECRET=openssl rand -base64 (length of secret )(eg. 128)
UXP_ENCRYPTION_KEY==openssl rand -base64 (length of secret )(eg. 128)

NODE_ENV=development

SECURE_COOKIE=false/true

H2C_FILE_UPLOAD_PATH=file uploads path for H2C app
UHN_FILE_UPLOAD_PATH=file uploads path for UHN app
DEMO_FILE_UPLOAD_PATH=file uploads path for Demo app


UHN_WORKSPACE_PATH=file path for UHN workspaces
UHN_SANDBOX_PATH=/usr/lib/uhn
UHN_NODE_PATH=host node install dir to be used in sandbox

UHN_MASTER_INTERNAL_URL=http://localhost:3031

UXP_CONFIG_API_KEY=openssl rand -base64 32
UXP_HEALTH_API_KEY=openssl rand -base64 32
UXP_NOTIFICATION_API_KEY=openssl rand -base64 32

LOG_LEVEL=debug
TZ=runtime timezone